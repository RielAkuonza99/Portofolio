# InfinityFree (Apache). Verify each rule by HTTP request after deploy (see README).
DirectoryIndex index.php index.html
Options -Indexes
ErrorDocument 404 /404.html
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "same-origin"
</IfModule>
# Never serve secrets, SQL, or dotfiles
<FilesMatch "(^\.env|\.env$|\.sql$|\.log$|\.sh$|composer\.(json|lock)$|\.md$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
