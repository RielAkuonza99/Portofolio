# Copy to config/.env on the server (File Manager/FTP) and fill in. NEVER commit the real file.
APP_NAME=Portfolio Admin
APP_ENV=production
APP_TIMEZONE=Asia/Jakarta

# Random strings: openssl rand -hex 32  (APP_KEY >= 32 chars, SETUP_KEY >= 24 chars)
APP_KEY=
SETUP_KEY=

DB_HOST=
DB_NAME=
DB_USER=
DB_PASSWORD=

SESSION_SECURE=true
SESSION_SAME_SITE=Strict
SESSION_IDLE_MIN=30
SESSION_MAX_HOURS=8

IMGBB_API_KEY=
MAX_IMAGE_MB=5

STREAMABLE_VALIDATE=true

MEDIAFIRE_EMAIL=
MEDIAFIRE_PASSWORD=
MEDIAFIRE_APP_ID=
MEDIAFIRE_API_KEY=
MAX_DOC_MB=10

BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Portfolio
ADMIN_NOTIFICATION_EMAIL=
NOTIFY_ON_LOGIN=true

CONTACT_PER_HOUR=5
CONTACT_PER_DAY_GLOBAL=100
